rules_version = '2';

// Sandwich Index — Firestore security rules
//
// Browsers write nothing. Every collection is either public to read and
// written only by the server's Admin SDK (stores, observations), or private to
// the server altogether (submissions, rateLimits).
//
// Price reports used to be written straight from the browser, with these rules
// enforcing the price range, the one-report-per-day limit and the hold on big
// price moves. They now go through POST /api/stores/[id]/submissions
// (src/lib/submit.server.ts), because two checks cannot be made in a rule: a
// Cloudflare Turnstile token has to be verified with a secret, and the
// reporter is identified from the request's network address, which a rule
// never sees. That route makes every check these rules used to make. So the
// rules' job is to make the route the only way in.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // stores — public read, Admin SDK write only
    // ---------------------------------------------------------------------
    //
    // Writes come from the store sync and the price recompute, both of which
    // run through firebase-admin and bypass rules entirely. Clients are locked
    // out on purpose: a client that could edit a store's price could set it
    // to anything.

    match /stores/{storeId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // observations — prices seen by a feed, Admin SDK write only
    // ---------------------------------------------------------------------
    //
    // Written by the feed import, which is where the licence for each feed is
    // checked. Public to read so a store page can show where its price came
    // from. Clients are locked out for the same reason as `stores`.

    match /observations/{observationId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // rateLimits — the ledger behind "one report per store per day"
    // ---------------------------------------------------------------------
    //
    // Keyed `{reporter}_{storeId}` and written by the submission route. The
    // reporter code is derived from the visitor's network, so it is private:
    // a readable ledger would let anyone link one person's reports together.

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // submissions — the crowdsourced price records
    // ---------------------------------------------------------------------
    //
    // Written by the submission route only. Not readable from the browser
    // either, because each one now carries its reporter code. The site never
    // read them from the browser anyway: the store page and the history API
    // read them on the server and send the public fields only.

    match /submissions/{submissionId} {
      allow read, write: if false;
    }
  }
}
