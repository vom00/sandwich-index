{
  "name": "sandwich-index",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only firestore,auth --import=.emulator-data --export-on-exit=.emulator-data",
    "emulators:clean": "firebase emulators:start --only firestore,auth",
    "test": "vitest run tests/unit",
    "pretest:emulated": "node scripts/stop-test-emulator.mjs",
    "posttest:emulated": "node scripts/stop-test-emulator.mjs",
    "test:emulated": "firebase emulators:exec --only firestore,auth --config firebase.itest.json \"vitest run\"",
    "seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "import:observations": "tsx --conditions=react-server --env-file=.env.local scripts/import-observations.ts",
    "pretest:rules": "node scripts/stop-test-emulator.mjs",
    "posttest:rules": "node scripts/stop-test-emulator.mjs",
    "test:rules": "firebase emulators:exec --only firestore --config firebase.itest.json \"vitest run tests/rules\"",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:a11y": "node tests/browser/taptargets.js && node tests/browser/keyboard.js && node tests/browser/semantics.js",
    "test:browser": "node tests/browser/phase1.js && node tests/browser/phase3.js && node tests/browser/phase4.js && node tests/browser/phase5.js && node tests/browser/phase6.js && node tests/browser/logrun.js && node tests/browser/hydration.js && node tests/browser/map-race.js"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "motion": "^13.0.0",
    "next": "16.3.8",
    "ngeohash": "^0.6.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^15.26.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
