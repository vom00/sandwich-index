# Sandwich Index — production environment for Vercel.
#
# Every value here is public: Firebase web config ships to every browser by
# design, and access is enforced by firestore.rules, not by hiding these.
# Import this file in Vercel → Project → Settings → Environment Variables
# (paste it in), for the Production environment.
#
# Not in this file, because they are secrets: FIREBASE_CLIENT_EMAIL and
# FIREBASE_PRIVATE_KEY, from a service account key generated in the Firebase
# console (Project settings → Service accounts → Generate new private key).
# Add those two in Vercel by hand. Never commit them.

NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sandwich-index-app
FIREBASE_PROJECT_ID=sandwich-index-app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAz60ewreR-BLoTSxwlI-FY46p1h4Yq7dc
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sandwich-index-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sandwich-index-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=787353936222
NEXT_PUBLIC_FIREBASE_APP_ID=1:787353936222:web:e04a8c2a3e1a9d59e1afcf

# Production only (robots.txt, sitemap.xml, and the User-Agent sent to
# OpenStreetMap services all use it).
NEXT_PUBLIC_SITE_URL=https://sandwich-index.vercel.app
