# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template documents setup and must be committed.
!.env.local.example

# firebase emulator artefacts
firebase-debug.log
firestore-debug.log
ui-debug.log
/.firebase/
# Seeded emulator snapshot. Synthetic prices — never commit, never deploy.
/.emulator-data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.next-build/

/tests/browser/screenshots/

# Price-feed files fetched on demand. Third-party data, regenerated, never committed.
/feeds/

# OCR engine and model, copied from node_modules by scripts/copy-ocr-assets.mjs
/public/ocr/
