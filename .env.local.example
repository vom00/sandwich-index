# Sandwich Index — environment
#
# Copy to .env.local. The defaults below run entirely against the Firebase
# emulator suite and never touch a real project: the `demo-` project id prefix
# makes the Firebase SDKs refuse to reach production even by accident.

# ---------------------------------------------------------------------------
# Emulator-first local development
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sandwich-index
FIREBASE_PROJECT_ID=demo-sandwich-index

# Read by firebase-admin. Presence of this variable is what puts the Admin SDK
# into emulator mode, so credentials are not needed.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# The client SDK requires these keys to exist but does not validate them
# against the emulator. Real values only matter when pointing at a real project.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-sandwich-index.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-sandwich-index.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ---------------------------------------------------------------------------
# Production (leave unset until a real Firebase project is wired)
# ---------------------------------------------------------------------------
# Set NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false and unset FIRESTORE_EMULATOR_HOST
# and FIREBASE_AUTH_EMULATOR_HOST, then supply:
#
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Also set FIREBASE_PROJECT_ID and NEXT_PUBLIC_FIREBASE_PROJECT_ID to the real
# project id. The Admin SDK refuses to start if credentials are supplied while
# FIREBASE_PROJECT_ID is unset, rather than authenticating against the demo-
# fallback and failing opaquely.

# Canonical origin for robots.txt and sitemap.xml. Unset falls back to
# http://localhost:3000, which in production would advertise localhost to
# crawlers.
# NEXT_PUBLIC_SITE_URL=https://example.com

# App Check. Leaving this unset keeps App Check inert, which is required for
# Playwright to run at all — a headless browser cannot solve reCAPTCHA.
# Enforcement is switched on in Phase 6, with a debug token for local runs.
# NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Contact address sent in the Overpass API User-Agent. Overpass is a donated
# shared resource and asks that automated clients identify themselves.
OVERPASS_CONTACT_EMAIL=you@example.com
